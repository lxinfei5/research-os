__pycache__/
*.pyc
.venv/
.pytest_cache/
.DS_Store
.env

# webbridge-mcp Go build artifacts (rebuildable: `social_mcp_daemon.sh build`). The .go/.mod/.sum
# sources ARE committed; the compiled binary is not. Cover both the daemon's `-o webbridge-mcp`
# output AND a plain `go build` (which names the binary after the dir, webbridge_mcp).
tools/social_mcp/webbridge_mcp/webbridge-mcp
tools/social_mcp/webbridge_mcp/webbridge_mcp

# Live SQLite databases — never committed (git checkout would clobber a working DB).
# Durable knowledge is committed as topics/<slug>/snapshots/<date>.sql instead.
topics/*/knowledge.db
topics/*/sources.db
topics/*/*.db-journal
topics/*/*.db-wal
topics/*/*.db-shm
# shared method store is a rebuildable cache (source of truth is each topic's knowledge.db)
topics/_shared/*.db

# Regenerable media: video/image are transcribed to TEXT before retention, so the binaries
# are disposable. The transcripts/ and cache/ text snapshots ARE committed.
library/media/

# Condense work caches (resumable per-unit .in/.out.json). Regenerable; committing them would
# cause stale cross-machine resume. The condensed knowledge lives in knowledge.db / snapshots/.
topics/*/artifacts/

# Local-only active-topic pointer.
.ros/

logs/

# macOS duplicate copies — Finder "copy"/iCloud restore name collisions produce "<file> 2.<ext>".
# These are byte-identical clones of already-tracked originals (verified), so ignore and never commit.
**/* 2.md
**/* 2.json
**/* 2.sql
**/* 2.txt
**/* 2.yaml
**/* 2.yml
