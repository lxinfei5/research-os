# Copy these variables into the environment of the runtime or launcher.
# Leave repository paths empty when the launcher can derive them from its location.

SOCIAL_MCP_HOME=

# Kimi daemon — HEALTH CHECK ONLY. Never curl :10086/command from agents.
SOCIAL_MCP_KIMI_URL=http://127.0.0.1:10086

# xiaohongshu-mcp :18060 — UNFENCED residual (not in the sibling webbridge fence).
SOCIAL_MCP_XHS_REPO=
SOCIAL_MCP_XHS_BIN=
SOCIAL_MCP_XHS_PORT=18060

# Fenced webbridge-mcp is user-level (launchd / ~/.webbridge-mcp), not this tree.
# SOCIAL_MCP_WEBBRIDGE_MCP_REPO is ignored; the daemon will not compile or bind :18061.
SOCIAL_MCP_WEBBRIDGE_MCP_PORT=18061

# Optional: set on the LIVE fenced process AND mirror in .mcp.json headers.Authorization.
# ROS_WEBBRIDGE_TOKEN=

SOCIAL_MCP_GO=

# rednote runtime (required when Node is not on PATH)
PLAYWRIGHT_NODEJS_PATH=
PLAYWRIGHT_NPM_PATH=
