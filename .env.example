# ResearchOS environment (copy to .env; .env is gitignored). Python never reads secrets into the DB.

# ── public web search (zhipu MCP: web-search-prime + web-reader) ──
ZHIPU_API_KEY=

# ── Xiaohongshu (hard constraint: MCP only, never kimi-webbridge) ──
# Local xiaohongshu-mcp server endpoint (holds the XHS login session).
ROS_XHS_MCP_URL=http://localhost:18060/mcp

# ── condense agent (claude -p headless) ──
# ROS_MODEL=claude-opus-4-8           # pin a model for the condense AGENT step (optional)
# ROS_AGENT_CMD=                      # override the agent command (tests use a stub); unset = claude -p

# ── media → text ──
# ROS_WHISPER_CLI=whisper-cli         # whisper.cpp binary (default: PATH lookup)
# ROS_WHISPER_MODEL=/path/ggml-large-v3-turbo.bin
# ROS_AUDIO_CONVERTER=                # afconvert (macOS default) or ffmpeg
# ROS_OCR_BACKEND=zai-mcp             # zai-mcp (agent) | tesseract | paddleocr | stub

# ── data root override (tests/alternate locations) ──
# ROS_ROOT=
