# Optional local overrides (copy to .env — never commit .env)

# Browser bridge (only if not using Codex native browser)
# SOCIAL_MCP_KIMI_URL=http://127.0.0.1:10086
# SOCIAL_MCP_WEBBRIDGE_MCP_PORT=18061

# Optional Xiaohongshu MCP if you maintain one locally
# ROS_XHS_MCP_URL=http://localhost:18060/mcp

# Media helpers (optional)
# ROS_WHISPER_CLI=whisper-cli
# ROS_WHISPER_MODEL=/path/to/ggml-model.bin
