# Optional local overrides (copy to .env — never commit .env)

# Browser bridge (only if not using Codex native browser)
# SOCIAL_MCP_KIMI_URL=http://127.0.0.1:10086   # health-check only; never curl /command
# SOCIAL_MCP_WEBBRIDGE_MCP_PORT=18061          # fenced user-level runtime; this repo does not bind it
# ROS_WEBBRIDGE_TOKEN=                         # set on the LIVE process AND .mcp.json headers.Authorization

# Optional Xiaohongshu MCP if you maintain one locally (UNFENCED residual)
# ROS_XHS_MCP_URL=http://127.0.0.1:18060/mcp

# Media helpers (optional)
# ROS_WHISPER_CLI=whisper-cli
# ROS_WHISPER_MODEL=/path/to/ggml-model.bin
